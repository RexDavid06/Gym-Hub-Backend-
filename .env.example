# Production (Render) sets DJANGO_SETTINGS_MODULE=config.settings.prod and
# supplies DATABASE_URL, REDIS_URL/CELERY_*, and RENDER_EXTERNAL_HOSTNAME.
# Add custom domains to DJANGO_ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://your-dashboard.example.com
# Proxies in front of the API. 0 (default) ignores X-Forwarded-For, so per-IP
# throttle limits key on REMOTE_ADDR. It MUST match the host: set NUM_PROXIES=1
# when running behind Render (or any single proxy) or limits apply per proxy.
NUM_PROXIES=0
# Rate limit for owner self-registration (drf-spectacular style rate string).
REGISTER_GYM_THROTTLE_RATE=5/hour

# Celery and Redis. Development defaults to eager mode so no broker is needed;
# set CELERY_TASK_ALWAYS_EAGER=false to exercise a real worker and broker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_EAGER_PROPAGATES=true

# Notification providers. "console" logs masked recipients in development.
# Production accepts "termii" or "disabled" for SMS and "meta" or "disabled"
# for WhatsApp, and fails at startup when credentials are missing.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_MEMBERSHIP_REMINDER=membership_reminder
WHATSAPP_TEMPLATE_MEMBERSHIP_EXPIRED=membership_expired
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=payment_receipt
NOTIFICATION_HTTP_TIMEOUT=10
